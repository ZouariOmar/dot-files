# ==================================================================================
# .FILE
#   .bash_colors
#
# .SYNOPSIS
#   Shell customization script for defining color and text style codes.
#
# .DESCRIPTION
#   This script is sourced during the initialization of an interactive shell session.
#   It defines ANSI escape sequences for text styling (e.g., bold, underline, color)
#   to enhance the readability and appearance of terminal output.
#
# .PARAMETER N/A
#   This file does not accept parameters; it is sourced automatically by the shell.
#
# .INPUTS
#   None
#
# .OUTPUTS
#   Environment variables representing ANSI escape codes for styles and colors.
#
# .NOTES
#   Version       : 1.0
#   Author        : @ZouariOmar <zouariomar20@gmail.com>
#   Created       : 2025-09-12
#   Change Log    : Initial version
#
# .EXAMPLE
#   N/A — this file is sourced automatically by the shell.
# ==================================================================================


# === TEXT STYLES ===
RESET='\e[0m'
BOLD='\e[1m'
DIM='\e[2m'
UNDERLINE='\e[4m'
BLINK='\e[5m'
REVERSE='\e[7m'
HIDDEN='\e[8m'

# === REGULAR FOREGROUND COLORS ===
BLACK='\e[30m'
RED='\e[31m'
GREEN='\e[32m'
YELLOW='\e[33m'
BLUE='\e[34m'
MAGENTA='\e[35m'
CYAN='\e[36m'
WHITE='\e[37m'

# === BOLD FOREGROUND COLORS ===
BOLD_BLACK='\e[1;30m'
BOLD_RED='\e[1;31m'
BOLD_GREEN='\e[1;32m'
BOLD_YELLOW='\e[1;33m'
BOLD_BLUE='\e[1;34m'
BOLD_MAGENTA='\e[1;35m'
BOLD_CYAN='\e[1;36m'
BOLD_WHITE='\e[1;37m'

# === BACKGROUND COLORS ===
BG_BLACK='\e[40m'
BG_RED='\e[41m'
BG_GREEN='\e[42m'
BG_YELLOW='\e[43m'
BG_BLUE='\e[44m'
BG_MAGENTA='\e[45m'
BG_CYAN='\e[46m'
BG_WHITE='\e[47m'

# === 256-COLOR FOREGROUND EXAMPLE ===
FG_256() { echo -e "\e[38;5;${1}m"; }  # Usage: $(FG_256 202)
BG_256() { echo -e "\e[48;5;${1}m"; }  # Usage: $(BG_256 240)

# === TRUECOLOR / RGB COLOR SUPPORT ===
# Usage: $(RGB_FG 255 100 0) for orange text
RGB_FG() { echo -e "\e[38;2;${1};${2};${3}m"; }
RGB_BG() { echo -e "\e[48;2;${1};${2};${3}m"; }
