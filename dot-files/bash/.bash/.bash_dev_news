#!/usr/bin/env bash
# =========================================================
# File: .bash_dev_news
# Description:
#   Fetch latest developer/Linux news from various sources.
#
# Sources:
#   - Arch Linux
#   - It's FOSS
#
# Usage:
#   devnews <source> <count>
#
# Examples:
#   devnews arch 5
#   devnews itsfoss 10
#   devnews --help
#
# Author:
#   @ZouariOmar (zouariomar20@gmail.com)
#
# Created:
#   2026-03-07
# =========================================================

# ---------------------------------------------------------
# Sources
# ---------------------------------------------------------
declare -A BASE=(
  [arch]="https://archlinux.org"
  [itsfoss]="https://itsfoss.com"
)

declare -A URL=(
  [arch]="https://archlinux.org/news/"
  [itsfoss]="https://itsfoss.com/news/"
)

declare -A REGEX=(
  [arch]='href="/news/[^"]+"'
  [itsfoss]='https://itsfoss.com/news/[^"]+'
)

declare -A PREFIX=(
  [arch]="https://archlinux.org"
  [itsfoss]=""
)

# ---------------------------------------------------------
# Print Help
# ---------------------------------------------------------
_devnews_help() {
  cat <<EOF
${CYAN}devnews${RESET} - Fetch latest Linux/dev news

${YELLOW}USAGE:${RESET}
  devnews <source> [count=10]

${YELLOW}SOURCES:${RESET}
  arch        Latest Arch Linux news
  itsfoss     Latest It's FOSS articles

${YELLOW}OPTIONS:${RESET}
  -h, --help      Show this help message
  -u, --usage     Show short usage

${YELLOW}EXAMPLES:${RESET}
  devnews arch 5
  devnews itsfoss 10

EOF
}

# ---------------------------------------------------------
# Print Usage
# ---------------------------------------------------------
_devnews_usage() {
  echo -e "${YELLOW}[USAGE]${RESET} devnews <source> [count=10]"
}

# ---------------------------------------------------------
# Validate Number
# ---------------------------------------------------------
_devnews_validate_count() {
  local count="$1"

  if ! [[ "$count" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}[ERROR]${RESET} Count must be a positive integer."
    return 1
  fi

  return 0
}

# ---------------------------------------------------------
# Fetch News
# ---------------------------------------------------------
_devnews_fetch() {
  local source="$1"
  local count="$2"

  echo -e "${BLUE}[INFO] Latest ${source^^} News\n.\n.\n.${RESET}"

  curl -s "${URL[$source]}" |
    grep -Eo "${REGEX[$source]}" |
    sed 's/href="//' |
    sed 's/"$//' |
    sed 's/[?#].*//' |
    sort -u |
    head -n "$count" |
    sed "s|^|${PREFIX[$source]}|" |
    nl -w2 -s'. '
}

# ---------------------------------------------------------
# Main Function
# ---------------------------------------------------------
devnews() {
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    _devnews_usage
    return 1
  fi

  case "$1" in
  -h | --help)
    _devnews_help
    return 0
    ;;

  -u | --usage)
    _devnews_usage
    return 0
    ;;

  "")
    _devnews_usage
    return 1
    ;;
  esac

  local source="$1"
  local count="${2:-10}"

  _devnews_validate_count "$count" || return 1

  if [[ -z "${URL[$source]}" ]]; then
    echo -e "${RED}[ERROR]${RESET} Unknown source '$source'\n"
    _devnews_help
    return 1
  fi

  _devnews_fetch "$source" "$count"
}
