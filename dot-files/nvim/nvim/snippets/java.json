{
  "Class Javadoc": {
    "prefix": "docc",
    "body": [
      "/**",
      " * ${1:Brief description of this class.}",
      " *",
      " * <p>${2:Detailed explanation of the class. Example features or responsibilities:}</p>",
      " * <ul>",
      " *     <li>${3:First feature or responsibility}</li>",
      " *     <li>${4:Second feature or responsibility}</li>",
      " *     <li>${5:Additional features}</li>",
      " * </ul>",
      " *",
      " * @author ${6:@ZouariOmar (zouariomar20@gmail.com)}",
      " * @version ${7:1.0.0}",
      " * @since ${8:YYYY-MM-DD}",
      " * @deprecated ${9:Reason and alternative if deprecated}",
      " * @see ${10:RelatedClassOrDocumentation}",
      " * @serial ${11:Serialization details (if applicable)}",
      " * @implNote ${12:Implementation notes if needed}",
      " * @apiNote ${13:API notes or usage hints}",
      " *",
      " * <pre>",
      " * {@code",
      " * ${14:// Example usage of this class}",
      " * }</pre>",
      " */"
    ],
    "description": "Comprehensive Javadoc template for a Java class with list support"
  },
  "Method Javadoc": {
    "prefix": "doc",
    "body": [
      "/**",
      " * ${1:Brief summary of the method.}",
      " *",
      " * <p>${2:Detailed description or notes about the method. Example behavior:}</p>",
      " * <ul>",
      " *     <li>${3:First behavior or detail}</li>",
      " *     <li>${4:Second behavior or detail}</li>",
      " *     <li>${5:Additional behaviors or notes}</li>",
      " * </ul>",
      " *",
      " * @param ${6:param1} ${7:description of param1}",
      " * @param ${8:param2} ${9:description of param2}",
      " * ${10:@throws ${11:ExceptionType} ${12:conditions when this exception is thrown}}",
      " * @return ${13:description of the returned value}",
      " * @see ${14:RelatedClassOrMethod}",
      " * @since ${15:YYYY-MM-DD}",
      " * @deprecated ${16:Reason and alternative if deprecated}",
      " * @implNote ${17:Implementation notes if needed}",
      " * @apiNote ${18:API notes or usage hints}",
      " *",
      " * <pre>",
      " * {@code",
      " * ${19:// Example usage of this method}",
      " * }</pre>",
      " */"
    ],
    "description": "Comprehensive Javadoc template for a Java method with list support"
  }
}
