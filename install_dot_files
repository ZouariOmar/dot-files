# =========================================
# Argument parsing & dispatch
# =========================================

COMPONENTS=()
DO_REMOTE=false

# No args → install everything locally
[[ $# -eq 0 ]] && install_all && exit $EXIT_SUCCESS

while [[ $# -gt 0 ]]; do
  case "$1" in
  --help | -h) help ;;
  --remote) DO_REMOTE=true ;;
  --local) DO_REMOTE=false ;;
  --all) COMPONENTS+=(all) ;;
  --bash) COMPONENTS+=(bash) ;;
  --git) COMPONENTS+=(git) ;;
  --nvim) COMPONENTS+=(nvim) ;;
  --neofetch) COMPONENTS+=(neofetch) ;;
  --clang) COMPONENTS+=(clang) ;;
  --vscode) COMPONENTS+=(vscode) ;;
  --docker) COMPONENTS+=(docker) ;;
  --nvidia) COMPONENTS+=(nvidia) ;;
  --obs) COMPONENTS+=(obs) ;;
  --servers) COMPONENTS+=(servers) ;;
  --linux) COMPONENTS+=(linux) ;;
  *)
    log_error "Unknown option: $1"
    echo -e "Run ${BOLD}./install_dot_files --help${RESET} for usage."
    exit $EXIT_FAILURE
    ;;
  esac
  shift
done

# Setup remote mode (overrides DOT_FILES_DIR) before any install
$DO_REMOTE && setup_remote

# No component flags given → install all
[[ ${#COMPONENTS[@]} -eq 0 ]] && install_all && exit $EXIT_SUCCESS

for c in "${COMPONENTS[@]}"; do
  case "$c" in
  all) install_all ;;
  bash) install_bash ;;
  git) install_git ;;
  nvim) install_nvim ;;
  neofetch) install_neofetch ;;
  clang) install_clang ;;
  vscode) install_vscode ;;
  docker) install_docker ;;
  nvidia) install_nvidia ;;
  obs) install_obs ;;
  servers) install_servers ;;
  linux) install_linux ;;
  esac
done

exit $EXIT_SUCCESS
